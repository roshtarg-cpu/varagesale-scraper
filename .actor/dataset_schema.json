{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "url": {
      "type": "string",
      "title": "URL",
      "description": "Direct link to the listing"
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Listing title"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Full listing description"
    },
    "price": {
      "type": "string",
      "title": "Price",
      "description": "Formatted price with currency"
    },
    "priceValue": {
      "type": "string",
      "title": "Price Value",
      "description": "Numeric price value"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "description": "Price currency (USD, EUR, etc.)"
    },
    "image": {
      "type": "string",
      "title": "Image URL",
      "description": "Main listing image"
    },
    "availability": {
      "type": "string",
      "title": "Availability",
      "description": "Product availability status"
    },
    "scrapedAt": {
      "type": "string",
      "title": "Scraped At",
      "description": "Timestamp when data was collected"
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": ["url", "title", "price", "availability"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": {
            "label": "URL",
            "format": "link"
          },
          "title": {
            "label": "Title",
            "format": "text"
          },
          "price": {
            "label": "Price",
            "format": "text"
          },
          "availability": {
            "label": "Status",
            "format": "text"
          }
        }
      }
    }
  }
}
