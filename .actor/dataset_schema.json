{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "url": {
      "type": "string",
      "title": "URL"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "price": {
      "type": "string",
      "title": "Price"
    },
    "priceValue": {
      "type": "string",
      "title": "Price Value"
    },
    "currency": {
      "type": "string",
      "title": "Currency"
    },
    "image": {
      "type": "string",
      "title": "Image URL"
    },
    "availability": {
      "type": "string",
      "title": "Availability"
    },
    "scrapedAt": {
      "type": "string",
      "title": "Scraped At"
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": ["url", "title", "price", "availability"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": {
            "label": "URL",
            "format": "link"
          },
          "title": {
            "label": "Title",
            "format": "text"
          },
          "price": {
            "label": "Price",
            "format": "text"
          },
          "availability": {
            "label": "Status",
            "format": "text"
          }
        }
      }
    }
  }
}
