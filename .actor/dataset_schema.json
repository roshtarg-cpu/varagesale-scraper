{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "url": "string",
    "title": "string", 
    "description": "string",
    "price": "string",
    "image": "string",
    "location": "string",
    "scrapedAt": "string"
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": ["url", "title", "price", "location"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": {
            "label": "URL",
            "format": "link"
          },
          "title": {
            "label": "Title",
            "format": "text"
          },
          "price": {
            "label": "Price",
            "format": "text"
          },
          "location": {
            "label": "Location",
            "format": "text"
          }
        }
      }
    }
  }
}
