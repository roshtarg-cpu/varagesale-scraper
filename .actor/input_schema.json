{
  "title": "VarageSale Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "location": {
      "title": "Location",
      "type": "string",
      "description": "VarageSale location slug (e.g., 'toronto', 'chicago', 'seattle')",
      "default": "toronto",
      "editor": "textfield"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of listings to scrape",
      "default": 10,
      "minimum": 1,
      "maximum": 100,
      "editor": "number"
    }
  },
  "required": ["location", "maxResults"]
}
